    const filterGroupStyle=document.createElement('style');filterGroupStyle.textContent=`.annual-head{display:grid!important;grid-template-columns:minmax(0,1fr) minmax(210px,260px);align-items:stretch!important;padding:6px!important;background:#f3f7f5!important;border-color:#d5e3dd!important}.annual-filter{display:flex;align-items:stretch!important;gap:7px!important}.annual-source-controls,.annual-detail-tabs,.annual-search-group{position:relative;display:flex;align-items:flex-end;gap:5px;padding:18px 7px 6px;border:1px solid #d8e5df;border-radius:9px;background:#fff}.annual-source-controls{flex:0 1 auto}.annual-group-label{position:absolute;top:3px;left:8px;color:#718078;font-size:.5625rem;font-weight:600;line-height:1}.annual-detail-tabs{padding-left:7px!important;margin-left:0!important;background:#f8faf9}.annual-detail-tabs button{height:30px!important;padding:0 12px!important}.annual-search-group{display:grid;align-content:end;padding-inline:7px}.annual-search-group input{width:100%!important;height:30px!important;border:0!important;background:#f4f7f5!important}.annual-source-controls label{gap:1px!important}.annual-source-controls select,.annual-source-controls .btn{height:30px!important}.annual-source-controls .btn{padding-inline:12px}.annual-quarter-chip{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 6px 0 10px;border-radius:999px;background:#fff0dc;color:#8a5a1a;font-size:.6875rem;font-weight:700;white-space:nowrap}.annual-quarter-chip b{font-weight:700}.annual-quarter-chip button{width:18px;height:18px;border:0;border-radius:50%;background:#f0d3ab;color:#8a5a1a;font-size:.625rem;line-height:1;cursor:pointer;display:grid;place-items:center}.annual-quarter-chip button:hover{background:#e3bd82}.mode-dashboard .annual-head{grid-template-columns:1fr!important}.mode-dashboard .annual-source-controls{flex:1}.mode-dashboard .annual-detail-tabs,.mode-dashboard .annual-search-group{display:none!important}.mode-detail .annual-detail-tabs{display:flex}.annual-head:focus-within{border-color:#91b9aa!important}@media(max-width:1050px){.annual-head{grid-template-columns:1fr!important}.annual-search-group{min-height:48px}.annual-filter{flex-wrap:wrap}.annual-source-controls{flex:1 1 100%}.annual-detail-tabs{flex:1 1 100%}}@media(max-width:650px){.annual-source-controls{align-items:stretch;flex-direction:column;padding-top:20px}.annual-source-controls label,.annual-source-controls select,.annual-source-controls .btn{width:100%!important}.annual-detail-tabs{display:grid!important;grid-template-columns:1fr 1fr;padding-top:20px!important}}`;document.head.appendChild(filterGroupStyle);
    const planStatusStyle=document.createElement('style');planStatusStyle.textContent=`.row-status-chip{display:inline-flex;align-items:center;border-radius:999px;padding:3px 7px;font-size:.625rem;font-weight:600;margin-top:4px;width:max-content}.row-status-chip.not-started{background:#edf0ef;color:#68736e}.row-status-chip.below{background:#fff0dc;color:#976018}.row-status-chip.on-track{background:#e6f3ed;color:#237059}.row-status-chip.over{background:#fbe8e9;color:#b43f45}.purchase-unit{display:block;font-weight:400;color:#38453f}.package-size{margin-top:2px;color:#66766f}.plan-data-row td:first-child{border-left:4px solid transparent}.plan-data-row.not-started td:first-child{border-left-color:#9aa49f}.plan-data-row.below td:first-child{border-left-color:#d58a2c}.plan-data-row.on-track td:first-child{border-left-color:#278267}.plan-data-row.over td:first-child{border-left-color:#d04f55}.annual-table .quarter-qty.has-value{background:#dff1e9!important;color:#176b54;font-weight:800}.plan-data-row:hover td{filter:brightness(.985)}`;document.head.appendChild(planStatusStyle);
    $('annualPlanSearch').addEventListener('input',debounce(()=>{annualDetailPage=1;renderAnnualPlan()}));
    $('annualApply').addEventListener('click',loadAnnualPlanSelection);
    $('annualYear').addEventListener('change',refreshAnnualWarehouseFilter);
    $('annualQuarterSelect').addEventListener('change',renderAnnualPlan);
    $('annualQuarterClear').addEventListener('click',()=>{$('annualQuarterSelect').value='0';renderAnnualPlan()});
    $('annualQuarter').addEventListener('click',event=>{const card=event.target.closest('[data-quarter]');if(!card)return;$('annualQuarterSelect').value=card.dataset.quarter;renderAnnualPlan()});
    $('annualWarehouseRows').addEventListener('click',event=>{const row=event.target.closest('[data-warehouse-id]');if(!row)return;$('annualWarehouse').value=row.dataset.warehouseId;loadAnnualPlanSelection()});
    detailTabs.addEventListener('click',event=>{const button=event.target.closest('[data-plan-detail-type]');if(button){annualDetailPage=1;setAnnualViewMode('detail',button.dataset.planDetailType);renderAnnualPlan()}});$('annualDetailPageSize').addEventListener('change',()=>{annualDetailPageSize=Number($('annualDetailPageSize').value);annualDetailPage=1;renderAnnualPlan()});$('annualStatusFilter').addEventListener('change',()=>{annualStatusFilter=$('annualStatusFilter').value;annualDetailPage=1;renderAnnualPlan()});$('annualDetailPrev').addEventListener('click',()=>{if(annualDetailPage>1){annualDetailPage--;renderAnnualPlan()}});$('annualDetailNext').addEventListener('click',()=>{annualDetailPage++;renderAnnualPlan()});unplannedSection.addEventListener('click',event=>{if(!event.target.closest('[data-open-unplanned]'))return;annualDetailPage=1;setAnnualViewMode('detail','unplanned');document.querySelectorAll('.nav').forEach(x=>x.classList.toggle('active',x.dataset.view==='plan-detail'));$('pageTitle').textContent='รายละเอียดแผนจัดซื้อ';renderAnnualPlan()});setAnnualViewMode('dashboard');
  }
  async function fetchBudgetPlanOnly(budgetYear) {
    const year=Number(budgetYear);
    if(!Number.isInteger(year)||year<1900||year>2700) throw new Error('ปีงบประมาณไม่ถูกต้อง');
    const statement=`SELECT b.budget_id,b.budget_name,bt.stock_budget_type_name,bl.stock_budget_price FROM stock_budget b INNER JOIN stock_budget_list bl ON bl.budget_id=b.budget_id INNER JOIN stock_budget_type bt ON bt.stock_budget_type_id=b.stock_budget_type_id WHERE bl.stock_budget_year='${year}'`;
    return sqlRetry(statement);
  }
  async function fetchBudgetActual(budgetYear) {
    const year=Number(budgetYear);
    if(!Number.isInteger(year)||year<1900||year>2700) throw new Error('ปีงบประมาณไม่ถูกต้อง');
    const cy=year>=2400?year-543:year,qs=[`${cy-1}-10-01`,`${cy}-01-01`,`${cy}-04-01`,`${cy}-07-01`,`${cy}-10-01`],amt='d2.stock_package_qty*p2.stock_po_price';
    const statement=`SELECT p1.budget_id,SUM(CASE WHEN d1.stock_receive_date>='${qs[0]}' AND d1.stock_receive_date<'${qs[1]}' THEN ${amt} ELSE 0 END) AS q1,SUM(CASE WHEN d1.stock_receive_date>='${qs[1]}' AND d1.stock_receive_date<'${qs[2]}' THEN ${amt} ELSE 0 END) AS q2,SUM(CASE WHEN d1.stock_receive_date>='${qs[2]}' AND d1.stock_receive_date<'${qs[3]}' THEN ${amt} ELSE 0 END) AS q3,SUM(CASE WHEN d1.stock_receive_date>='${qs[3]}' AND d1.stock_receive_date<'${qs[4]}' THEN ${amt} ELSE 0 END) AS q4,SUM(${amt}) AS total,SUM(CASE WHEN p1.bdg_year IS NULL OR p1.bdg_year<>'${year}' THEN ${amt} ELSE 0 END) AS carryover FROM stock_po p1 JOIN stock_po_detail p2 ON p1.stock_po_id=p2.stock_po_id JOIN stock_deliver d1 ON p1.stock_po_id=d1.stock_po_id JOIN stock_deliver_detail d2 ON d1.stock_deliver_id=d2.stock_deliver_id AND d2.stock_po_detail_id=p2.stock_po_detail_id WHERE d1.stock_deliver_complete='Y' AND p1.po_cancel='N' AND p2.stock_po_item_type_id<>9 AND p1.po_type_id IN (1,200) AND d1.stock_receive_date>='${qs[0]}' AND d1.stock_receive_date<'${qs[4]}' GROUP BY p1.budget_id`;
    return sqlRetry(statement);
  }
  function normalizeBudgetRows(rows) {
    return rows.map(r=>{
      const planAmount=num(pick(r,['stock_budget_price'])),q1=0,q2=0,q3=0,q4=0,carryover=0,totalUse=0,balance=planAmount,rate=0,status=balance<0?'over':rate>=90?'near':'normal';
      return {budgetId:pick(r,['budget_id']),budgetName:pick(r,['budget_name'],'ไม่ระบุชื่องบประมาณ'),budgetType:pick(r,['stock_budget_type_name'],'—'),planAmount,q1,q2,q3,q4,carryover,totalUse,balance,rate,status};
    });
  }
  function mergeBudgetActual(actualRows) {
    const byId=new Map();actualRows.forEach(r=>byId.set(String(pick(r,['budget_id'])),r));
    budgetRows=budgetRows.map(row=>{
      const actual=byId.get(String(row.budgetId));if(!actual)return row;
      const q1=num(pick(actual,['q1'])),q2=num(pick(actual,['q2'])),q3=num(pick(actual,['q3'])),q4=num(pick(actual,['q4'])),carryover=num(pick(actual,['carryover'])),totalUse=num(pick(actual,['total'])),balance=row.planAmount-totalUse,rate=row.planAmount?totalUse*100/row.planAmount:0,status=balance<0?'over':rate>=90?'near':'normal';
      return {...row,q1,q2,q3,q4,carryover,totalUse,balance,rate,status};
    });
  }
  function budgetDrillFilters(budgetId,budgetYear) {
    const year=Number(budgetYear),id=Number(budgetId);
    if(!Number.isInteger(year)||year<1900||year>2700) throw new Error('ปีงบประมาณไม่ถูกต้อง');
    if(!Number.isInteger(id)) throw new Error('รหัสงบประมาณไม่ถูกต้อง');
    return `d1.stock_deliver_complete='Y' AND p1.po_cancel='N' AND p1.bdg_year=${year} AND p2.stock_po_item_type_id<>9 AND p1.budget_id=${id}`;
  }
  async function fetchBudgetPurchaseTotals(budgetId,budgetYear) {
    const filters=budgetDrillFilters(budgetId,budgetYear);
    const statement=`SELECT COUNT(*) AS po_count,SUM(item_count) AS total_items,SUM(po_amount) AS total_amount,SUM(receive_amount) AS total_receive_amount FROM (SELECT p1.stock_po_id,COUNT(*) AS item_count,MAX(p1.po_amount) AS po_amount,SUM(d2.stock_package_qty*p2.stock_po_price) AS receive_amount FROM stock_po p1 JOIN stock_po_detail p2 ON p1.stock_po_id=p2.stock_po_id JOIN stock_deliver d1 ON p1.stock_po_id=d1.stock_po_id JOIN stock_deliver_detail d2 ON d1.stock_deliver_id=d2.stock_deliver_id AND d2.stock_po_detail_id=p2.stock_po_detail_id WHERE ${filters} GROUP BY p1.stock_po_id) x`;
    return sqlRetry(statement);
  }
  async function fetchBudgetPurchaseSummaryPage(budgetId,budgetYear,page,pageSize) {
    const filters=budgetDrillFilters(budgetId,budgetYear),offset=(page-1)*pageSize;
    const statement=`SELECT p1.stock_po_id,MAX(p1.stock_po_no) AS stock_po_no,MAX(p1.stock_po_date) AS stock_po_date,MAX(w.warehouse_name) AS warehouse_name,MAX(p1.po_amount) AS po_amount,COUNT(*) AS item_count FROM stock_po p1 JOIN stock_po_detail p2 ON p1.stock_po_id=p2.stock_po_id JOIN stock_deliver d1 ON p1.stock_po_id=d1.stock_po_id JOIN stock_deliver_detail d2 ON d1.stock_deliver_id=d2.stock_deliver_id AND d2.stock_po_detail_id=p2.stock_po_detail_id JOIN stock_warehouse w ON w.warehouse_id=p1.warehouse_id WHERE ${filters} GROUP BY p1.stock_po_id ORDER BY MAX(p1.stock_po_date),MAX(p1.stock_po_no) LIMIT ${pageSize} OFFSET ${offset}`;
    return sqlRetry(statement);
  }
  async function fetchBudgetPurchaseItems(budgetId,budgetYear,poId) {
    const filters=budgetDrillFilters(budgetId,budgetYear),id=Number(poId);
    if(!Number.isInteger(id)) throw new Error('รหัสใบสั่งซื้อไม่ถูกต้อง');
    const statement=`SELECT ii.item_id,ii.item_code,ii.item_name,d2.stock_package_qty,concat(uu.item_unit_name,' [',uu.unit_qty,' ',ii.item_unit,']') as unit_name FROM stock_po p1 JOIN stock_po_detail p2 ON p1.stock_po_id=p2.stock_po_id JOIN stock_deliver d1 ON p1.stock_po_id=d1.stock_po_id JOIN stock_deliver_detail d2 ON d1.stock_deliver_id=d2.stock_deliver_id AND d2.stock_po_detail_id=p2.stock_po_detail_id JOIN stock_item ii ON ii.item_id=d2.item_id LEFT JOIN stock_item_unit uu ON uu.stock_item_unit_id=d2.stock_item_unit_id WHERE ${filters} AND p1.stock_po_id=${id} ORDER BY ii.item_name`;
    return sqlRetry(statement);
  }
  function normalizeBudgetPurchaseSummary(rows) {
    return rows.map(r=>({poId:pick(r,['stock_po_id']),poNo:pick(r,['stock_po_no'],''),poDate:pick(r,['stock_po_date']),warehouseName:pick(r,['warehouse_name'],'—'),poAmount:num(pick(r,['po_amount'])),itemCount:num(pick(r,['item_count'])),expanded:false,items:null,loading:false,error:''}));
  }
  function normalizeBudgetPurchaseItems(rows) {
    return rows.map(r=>({itemId:pick(r,['item_id']),itemCode:pick(r,['item_code']),itemName:pick(r,['item_name'],'ไม่ระบุรายการ'),qty:num(pick(r,['stock_package_qty'])),unitName:pick(r,['unit_name'],'—')}));
  }
  function renderBudgetDrill() {
    if(!$('budgetDrillRows'))return;
    const q=$('budgetDrillSearch').value.trim().toLowerCase();
    const pos=budgetDrillSummary.filter(po=>!q||po.poNo.toLowerCase().includes(q)||(po.items&&po.items.some(it=>`${it.itemCode} ${it.itemName}`.toLowerCase().includes(q))));
    $('budgetDrillPoCount').textContent=budgetDrillTotals.poCount.toLocaleString('th-TH');$('budgetDrillItemCount').textContent=budgetDrillTotals.itemCount.toLocaleString('th-TH');$('budgetDrillAmount').textContent=`${money(budgetDrillTotals.amount)} บ.`;
    $('budgetDrillSub').textContent=`${budgetDrillTotals.poCount.toLocaleString('th-TH')} ใบสั่งซื้อ · ${budgetDrillTotals.itemCount.toLocaleString('th-TH')} รายการสินค้า · ยอดรับจริง ${money(budgetDrillTotals.receiveAmount)} บาท`;
    const totalPages=Math.max(1,Math.ceil(budgetDrillTotals.poCount/budgetDrillPageSize));
    if($('budgetDrillPageInfo'))$('budgetDrillPageInfo').textContent=`หน้า ${budgetDrillPage} / ${totalPages}`;
    if($('budgetDrillPrev'))$('budgetDrillPrev').disabled=budgetDrillPage<=1;
    if($('budgetDrillNext'))$('budgetDrillNext').disabled=budgetDrillPage>=totalPages;
    $('budgetDrillRows').innerHTML=pos.length?pos.map(po=>{
      const poLabel=po.poNo?esc(po.poNo):'<span class="sub">ไม่มีเลขที่ PO</span>';
      const summaryRow=`<tr class="po-summary-row" data-po-id="${esc(po.poId)}"><td><span class="po-toggle">${po.expanded?'▾':'▸'}</span> <span class="po">${poLabel}</span></td><td>${dateText(po.poDate)}</td><td>${esc(po.warehouseName)}</td><td class="money">${po.itemCount.toLocaleString('th-TH')}</td><td class="money">${money(po.poAmount)}</td></tr>`;
      if(!po.expanded)return summaryRow;
      let detailRow;
      if(po.loading)detailRow=`<tr class="po-items-row"><td colspan="5" class="empty">กำลังอ่านรายการ…</td></tr>`;
      else if(po.error)detailRow=`<tr class="po-items-row"><td colspan="5" class="empty">อ่านรายการไม่สำเร็จ: ${esc(po.error)}</td></tr>`;
      else detailRow=`<tr class="po-items-row"><td colspan="5"><table class="po-items-table"><thead><tr><th>รหัสรายการ</th><th>รายการ</th><th>หน่วย</th><th style="text-align:right">จำนวน</th></tr></thead><tbody>${(po.items||[]).map(it=>`<tr><td><span class="po">${esc(it.itemCode||it.itemId||'—')}</span></td><td>${esc(it.itemName)}</td><td>${esc(it.unitName)}</td><td class="money">${it.qty.toLocaleString('th-TH',{maximumFractionDigits:2})}</td></tr>`).join('')}</tbody></table></td></tr>`;
      return summaryRow+detailRow;
    }).join(''):'<tr><td colspan="5" class="empty">ไม่พบรายการซื้อภายใต้งบนี้ในหน้านี้</td></tr>';
  }
  async function toggleBudgetDrillPo(poId) {
    const po=budgetDrillSummary.find(x=>String(x.poId)===String(poId));if(!po)return;
    if(po.expanded){po.expanded=false;renderBudgetDrill();return}
    po.expanded=true;
    if(po.items||po.loading){renderBudgetDrill();return}
    po.loading=true;renderBudgetDrill();
    try{
      po.items=normalizeBudgetPurchaseItems(await fetchBudgetPurchaseItems(budgetDrillContext.budgetId,budgetDrillContext.year,po.poId));
    }catch(error){po.error=error.message}
    finally{po.loading=false;renderBudgetDrill()}
  }
  async function loadBudgetDrillPage(page) {
    if(!budgetDrillContext)return;
    budgetDrillPage=Math.max(1,page);
    $('budgetDrillRows').innerHTML='<tr><td colspan="5" class="empty">กำลังอ่านข้อมูล…</td></tr>';
    try{
      budgetDrillSummary=normalizeBudgetPurchaseSummary(await fetchBudgetPurchaseSummaryPage(budgetDrillContext.budgetId,budgetDrillContext.year,budgetDrillPage,budgetDrillPageSize));renderBudgetDrill();
    }catch(error){
      $('budgetDrillRows').innerHTML=`<tr><td colspan="5" class="empty">อ่านข้อมูลไม่สำเร็จ: ${esc(error.message)}</td></tr>`;
    }
  }
  async function openBudgetDrill(budgetId,budgetName) {
    if(!config||!budgetId)return;
    budgetDrillContext={budgetId,budgetName,year:$('budgetYear').value};
    budgetDrillPage=1;
    $('budgetDrillBox').classList.add('show');
    $('budgetDrillTitle').textContent=`รายการซื้อภายใต้งบ: ${budgetName}`;
    $('budgetDrillSub').textContent='กำลังอ่านข้อมูล…';
    $('budgetDrillSearch').value='';
    $('budgetDrillRows').innerHTML='<tr><td colspan="5" class="empty">กำลังอ่านข้อมูล…</td></tr>';
    try{
      const year=budgetDrillContext.year;
      const [totalsRows,pageRows]=await Promise.all([fetchBudgetPurchaseTotals(budgetId,year),fetchBudgetPurchaseSummaryPage(budgetId,year,1,budgetDrillPageSize)]);
      const totals=totalsRows[0]||{};
      budgetDrillTotals={poCount:num(pick(totals,['po_count'])),itemCount:num(pick(totals,['total_items'])),amount:num(pick(totals,['total_amount'])),receiveAmount:num(pick(totals,['total_receive_amount']))};
      budgetDrillSummary=normalizeBudgetPurchaseSummary(pageRows);
      renderBudgetDrill();
    }catch(error){
      budgetDrillSummary=[];$('budgetDrillRows').innerHTML=`<tr><td colspan="5" class="empty">อ่านข้อมูลไม่สำเร็จ: ${esc(error.message)}</td></tr>`;$('budgetDrillSub').textContent='เกิดข้อผิดพลาด'
    }
  }
  function closeBudgetDrill() {
    $('budgetDrillBox').classList.remove('show');budgetDrillContext=null;
  }
  async function loadBudgetTracking() {
    if(!config)return;const year=$('budgetYear').value,button=$('budgetApply');button.disabled=true;button.textContent='กำลังโหลด…';$('budgetLabel').textContent='กำลังอ่านข้อมูล';budgetActualLoaded=false;
    if($('budgetNote')){$('budgetNote').textContent='';$('budgetNote').classList.remove('has-warning')}
    try{
      budgetRows=normalizeBudgetRows(await fetchBudgetPlanOnly(year));budgetLoadedYear=year;renderBudgetTracking();
    }catch(error){
      budgetRows=[];$('budgetRows').innerHTML=`<tr><td colspan="14" class="empty">อ่านข้อมูลงบประมาณไม่สำเร็จ: ${esc(error.message)}</td></tr>`;$('budgetLabel').textContent='ไม่สามารถโหลดข้อมูลได้';button.disabled=false;button.textContent='แสดงผล';return;
    }
    button.textContent='กำลังอ่านยอดใช้จ่าย…';
    try{
      mergeBudgetActual(await fetchBudgetActual(year));budgetActualLoaded=true;renderBudgetTracking();
    }catch(error){
      renderBudgetTracking();
      if($('budgetNote')){$('budgetNote').textContent=`ยอดใช้จ่ายรายไตรมาสอ่านไม่สำเร็จ (ตัวเลขที่แสดงเป็น 0 ยังไม่ใช่ยอดจริง): ${error.message}`;$('budgetNote').classList.add('has-warning')}
    }
    button.disabled=false;button.textContent='แสดงผล';
  }
  function renderBudgetTracking() {
    if(!$('budgetRows'))return;
    const q=$('budgetSearch').value.trim().toLowerCase(),{elapsed}=fiscalYearProgress($('budgetYear').value),yearClosed=elapsed>=1;
    const rows=budgetRows.filter(r=>!q||`${r.budgetId} ${r.budgetName} ${r.budgetType}`.toLowerCase().includes(q)).map(r=>{
      const forecast=elapsed>0&&elapsed<1?r.totalUse/elapsed:r.totalUse,forecastRate=r.planAmount?forecast*100/r.planAmount:0,riskOver=forecastRate>105,riskUnder=elapsed>=0.75&&r.planAmount>0&&r.rate<50;
      return {...r,forecast,forecastRate,riskOver,riskUnder};
    });
    const planTotal=rows.reduce((s,r)=>s+r.planAmount,0),usedTotal=rows.reduce((s,r)=>s+r.totalUse,0),remainTotal=planTotal-usedTotal,rateTotal=planTotal?usedTotal*100/planTotal:0,forecastTotal=elapsed>0&&elapsed<1?usedTotal/elapsed:usedTotal,forecastRateTotal=planTotal?forecastTotal*100/planTotal:0;
    $('bgPlan').textContent=`${money(planTotal)} บ.`;$('bgUsed').textContent=`${money(usedTotal)} บ.`;$('bgRate').textContent=`${rateTotal.toFixed(1)}%`;$('bgRemain').textContent=`${money(remainTotal)} บ.`;
    if($('bgForecastLabel'))$('bgForecastLabel').textContent=yearClosed?'ผลสิ้นปี':'คาดการณ์สิ้นปี';
    if($('bgForecast')){if(!budgetActualLoaded){$('bgForecast').textContent='—';$('bgForecastAmount').textContent='รอข้อมูลยอดใช้จ่าย'}else{$('bgForecast').textContent=`${forecastRateTotal.toFixed(1)}%`;$('bgForecastAmount').textContent=yearClosed?`ปิดปีงบประมาณแล้ว · ${money(forecastTotal)} บาท`:`เวลาผ่านไป ${(elapsed*100).toFixed(1)}% · คาด ${money(forecastTotal)} บาท`}}
    if($('budgetQuarter')){
      const totals=[1,2,3,4].map(i=>rows.reduce((s,r)=>s+num(r[`q${i}`]),0)),meaningfulBase=planTotal*0.01;
      $('budgetQuarter').innerHTML=[1,2,3,4].map((i,idx)=>{
        const amt=totals[idx],pctOfPlan=planTotal?amt*100/planTotal:0,prev=idx>0?totals[idx-1]:null;
        let deltaLabel,deltaColor;
        if(prev===null){deltaLabel='ไตรมาสแรกของปี';deltaColor='#87938e'}
        else{
          const diff=amt-prev;
          if(diff===0){deltaLabel=`เท่า Q${i-1}`;deltaColor='#87938e'}
          else if(prev>=meaningfulBase){deltaLabel=`${diff>=0?'▲':'▼'} ${Math.abs(diff*100/prev).toFixed(1)}% จาก Q${i-1}`;deltaColor=diff>0?'#d04f55':'#278267'}
          else{deltaLabel=`${diff>=0?'▲':'▼'} ${money(Math.abs(diff))} บาท จาก Q${i-1}`;deltaColor=diff>0?'#d04f55':'#278267'}
        }
        return `<article class="card quarter-card"><div><span>ไตรมาส ${i}</span><b>${money(amt)}</b></div><div class="quarter-track"><i style="width:${Math.min(100,pctOfPlan)}%"></i></div><small>${pctOfPlan.toFixed(1)}% ของงบทั้งหมด</small><small style="color:${deltaColor};font-weight:700">${deltaLabel}</small></article>`;
      }).join('');
    }
    if($('budgetCumulative')){
      let cum=0;const cumulative=[1,2,3,4].map(i=>{cum+=rows.reduce((s,r)=>s+num(r[`q${i}`]),0);return {quarter:i,actual:cum,expected:planTotal*i/4}}),cumMax=Math.max(1,...cumulative.flatMap(x=>[x.actual,x.expected]));
      $('budgetCumulative').innerHTML=cumulative.map(x=>`<div class="cumulative-row"><b>Q${x.quarter}</b><div><span>คาดหวัง (เฉลี่ยเท่ากัน)</span><i><em style="width:${x.expected*100/cumMax}%"></em></i><strong>${money(x.expected)}</strong></div><div><span>ใช้จริงสะสม</span><i><em class="actual" style="width:${x.actual*100/cumMax}%"></em></i><strong>${money(x.actual)}</strong></div></div>`).join('');
    }
    if($('budgetTypeRows')){
      const byType=[...rows.reduce((map,r)=>{const key=r.budgetType||'—',cur=map.get(key)||{type:key,plan:0,used:0,items:0};cur.plan+=r.planAmount;cur.used+=r.totalUse;cur.items++;map.set(key,cur);return map},new Map()).values()].map(x=>({...x,remain:x.plan-x.used,rate:x.plan?x.used*100/x.plan:0})).sort((a,b)=>a.remain-b.remain);
      $('budgetTypeRows').innerHTML=byType.length?byType.map((x,i)=>`<tr><td>${i+1}</td><td>${esc(x.type)}</td><td class="money">${money(x.plan)}</td><td class="money">${money(x.used)}</td><td class="money">${money(x.remain)}</td><td><div class="plan-rate"><i style="width:${Math.min(100,x.rate)}%;background:${x.remain<0?'#d04f55':x.rate>=90?'#d58a2c':'#278267'}"></i></div><small>${x.rate.toFixed(1)}%</small></td><td>${x.items.toLocaleString('th-TH')}</td></tr>`).join(''):'<tr><td colspan="7" class="empty">ไม่พบข้อมูล</td></tr>';
    }
    const riskPlaceholder='<tr><td colspan="6" class="empty">ยังไม่มีข้อมูลยอดใช้จ่าย — ประเมินความเสี่ยงไม่ได้</td></tr>';
    if($('budgetRiskOverTitle'))$('budgetRiskOverTitle').textContent=yearClosed?'ใช้เกินงบ':'เสี่ยงใช้เกินงบ';
    if($('budgetRiskOverNote'))$('budgetRiskOverNote').textContent=yearClosed?'ผลสิ้นปีงบประมาณเกิน 105% ของงบ':'คาดการณ์ทั้งปีจะเกิน 105% ของงบ';
    if($('budgetRiskUnderTitle'))$('budgetRiskUnderTitle').textContent=yearClosed?'ใช้ไม่ทันปี':'เสี่ยงใช้ไม่ทันปี';
    if($('budgetRiskUnderNote'))$('budgetRiskUnderNote').textContent=yearClosed?'สิ้นปีงบประมาณแล้วแต่ใช้ไม่ถึง 50%':'เวลาผ่านไป ≥75% แต่ใช้ไม่ถึง 50%';
    if($('budgetRiskOverRows')&&!budgetActualLoaded){$('budgetRiskOverRows').innerHTML=riskPlaceholder}else if($('budgetRiskOverRows')){
      const over=[...rows].filter(r=>r.riskOver).sort((a,b)=>b.forecastRate-a.forecastRate).slice(0,8);
      $('budgetRiskOverRows').innerHTML=over.length?over.map((r,i)=>`<tr class="budget-drill-row" data-budget-id="${esc(r.budgetId)}" data-budget-name="${esc(r.budgetName)}"><td>${i+1}</td><td><span class="po">${esc(r.budgetId)}</span></td><td>${esc(r.budgetName)}</td><td class="money">${money(r.planAmount)}</td><td class="money">${money(r.totalUse)}</td><td>${r.forecastRate.toFixed(1)}%</td></tr>`).join(''):`<tr><td colspan="6" class="empty">${yearClosed?'ไม่มีงบที่ใช้เกิน':'ไม่มีงบที่เสี่ยงเกิน'}</td></tr>`;
    }
    if($('budgetRiskUnderRows')&&!budgetActualLoaded){$('budgetRiskUnderRows').innerHTML=riskPlaceholder}else if($('budgetRiskUnderRows')){
      const under=[...rows].filter(r=>r.riskUnder).sort((a,b)=>b.balance-a.balance).slice(0,8);
      $('budgetRiskUnderRows').innerHTML=under.length?under.map((r,i)=>`<tr class="budget-drill-row" data-budget-id="${esc(r.budgetId)}" data-budget-name="${esc(r.budgetName)}"><td>${i+1}</td><td>${esc(r.budgetName)}</td><td class="money">${money(r.planAmount)}</td><td class="money">${money(r.balance)}</td><td>${r.rate.toFixed(1)}%</td></tr>`).join(''):`<tr><td colspan="5" class="empty">${yearClosed?'ไม่มีงบที่ใช้ไม่ทัน':'ไม่มีงบที่เสี่ยงใช้ไม่ทัน'}</td></tr>`;
    }
    if($('budgetRiskCount'))$('budgetRiskCount').textContent=budgetActualLoaded?rows.filter(r=>r.riskOver||r.riskUnder).length.toLocaleString('th-TH'):'—';
    const statusText={over:'เกินงบประมาณ',near:'ใกล้เต็มงบ',normal:'ปกติ'},statusClass={over:'over',near:'below',normal:'on-track'},barColor={over:'#d04f55',near:'#d58a2c',normal:'#278267'};
    const sorted=[...rows].sort((a,b)=>a.balance-b.balance);
    $('budgetLabel').textContent=`${sorted.length.toLocaleString('th-TH')} รายการ`;
    const typeGroups=new Map();
    sorted.forEach(r=>{const key=r.budgetType||'—';if(!typeGroups.has(key))typeGroups.set(key,{type:key,items:[],plan:0,used:0});const g=typeGroups.get(key);g.items.push(r);g.plan+=r.planAmount;g.used+=r.totalUse;g.carry=(g.carry||0)+num(r.carryover)});
    const groupList=[...typeGroups.values()].map(g=>({...g,remain:g.plan-g.used})).sort((a,b)=>a.remain-b.remain);
    let seq=0;
    $('budgetRows').innerHTML=groupList.length?groupList.map(g=>{
      const groupHeader=`<tr class="budget-type-group"><td colspan="14">${esc(g.type)}<span class="sub">· ${g.items.length.toLocaleString('th-TH')} รายการ · งบ ${money(g.plan)} · ใช้ไป ${money(g.used)} · เหลื่อมปี ${money(g.carry||0)} · คงเหลือ ${money(g.remain)}</span></td></tr>`;
      const itemRows=g.items.map(r=>{
        seq++;
        const sparkMax=Math.max(1,r.q1,r.q2,r.q3,r.q4),spark=`<div class="spark-bars">${[r.q1,r.q2,r.q3,r.q4].map(v=>`<i style="height:${Math.max(4,v*100/sparkMax)}%"></i>`).join('')}</div>`;
        return `<tr class="plan-data-row budget-drill-row ${statusClass[r.status]}" data-budget-id="${esc(r.budgetId)}" data-budget-name="${esc(r.budgetName)}"><td>${seq}</td><td>${esc(r.budgetName)}</td><td>${esc(r.budgetType)}</td><td class="money">${money(r.planAmount)}</td><td class="money">${money(r.q1)}</td><td class="money">${money(r.q2)}</td><td class="money">${money(r.q3)}</td><td class="money">${money(r.q4)}</td><td class="money">${money(r.totalUse)}</td><td class="money">${money(r.carryover)}</td><td class="money">${money(r.balance)}</td><td>${spark}</td><td><div class="plan-rate"><i style="width:${Math.min(100,r.rate)}%;background:${barColor[r.status]}"></i></div><small>${r.rate.toFixed(1)}%</small></td><td><span class="plan-status ${statusClass[r.status]}">${statusText[r.status]}</span></td></tr>`;
      }).join('');
      return groupHeader+itemRows;
    }).join(''):'<tr><td colspan="14" class="empty">ไม่พบข้อมูลงบประมาณ</td></tr>';
  }
  function mountBudgetTracking() {
    const view=document.createElement('section');view.id='budgetView';view.style.cssText='display:none;flex-direction:column;gap:9px;min-height:0;flex:1;overflow:auto';
    view.innerHTML='<div class="annual-head"><div class="annual-filter"><label>ปีงบประมาณ<select id="budgetYear"><option value="2566">2566</option></select></label><button class="btn primary" id="budgetApply" type="button">แสดงผล</button></div><input id="budgetSearch" placeholder="ค้นหางบประมาณ"></div><div class="annual-note" id="budgetNote"></div><section class="annual-kpis budget-dashboard-only"><article class="card annual-kpi green"><span>งบประมาณทั้งหมด</span><b id="bgPlan">—</b><small>ตามช่วงที่เลือก</small></article><article class="card annual-kpi blue"><span>ใช้ไปแล้ว</span><b id="bgUsed">—</b><small>มูลค่าตรวจรับ ต.ค.–ก.ย. ปีงบที่เลือก</small></article><article class="card annual-kpi amber"><span>% การใช้งบ</span><b id="bgRate">—</b><small>ใช้ไป ÷ งบประมาณ</small></article><article class="card annual-kpi red"><span>คงเหลือ</span><b id="bgRemain">—</b><small>งบประมาณ − ใช้ไป</small></article><article class="card annual-kpi purple"><span id="bgForecastLabel">คาดการณ์สิ้นปี</span><b id="bgForecast">—</b><small id="bgForecastAmount">ตามอัตราการใช้ปัจจุบัน</small></article></section><section id="budgetQuarter" class="annual-quarter budget-dashboard-only"></section><section class="hospital-overview budget-dashboard-only"><article class="card panel"><div class="panel-head"><div class="title">การใช้งบสะสมเทียบจังหวะที่ควรจะเป็น</div><div class="note">เฉลี่ยเท่ากันทุกไตรมาส = คาดหวัง</div></div><div id="budgetCumulative" class="annual-cumulative"></div></article><article class="card panel" id="budgetTypePanel"><div class="panel-head"><div class="title">สรุปตามประเภทงบประมาณ (กอง)</div><div class="note">เรียงตามคงเหลือน้อยไปมาก</div></div><div class="table-wrap warehouse-summary-wrap"><table><thead><tr><th>ลำดับ</th><th>ประเภทงบ</th><th>งบประมาณ</th><th>ใช้ไป</th><th>คงเหลือ</th><th>ผลการใช้งบ</th><th>รายการ</th></tr></thead><tbody id="budgetTypeRows"></tbody></table></div></article></section><section class="annual-risk-section budget-dashboard-only"><section class="annual-risk-grid" style="grid-template-columns:1fr 1fr"><article class="card panel risk-list"><div class="panel-head"><div class="title" id="budgetRiskOverTitle">เสี่ยงใช้เกินงบ</div><div class="note" id="budgetRiskOverNote">คาดการณ์ทั้งปีจะเกิน 105% ของงบ</div></div><div class="table-wrap"><table><thead><tr><th>ลำดับ</th><th>รหัส</th><th>ชื่องบประมาณ</th><th>งบประมาณ</th><th>ใช้ไปแล้ว</th><th>คาดการณ์สิ้นปี</th></tr></thead><tbody id="budgetRiskOverRows"></tbody></table></div></article><article class="card panel risk-list"><div class="panel-head"><div class="title" id="budgetRiskUnderTitle">เสี่ยงใช้ไม่ทันปี</div><div class="note" id="budgetRiskUnderNote">เวลาผ่านไป ≥75% แต่ใช้ไม่ถึง 50%</div></div><div class="table-wrap"><table><thead><tr><th>ลำดับ</th><th>ชื่องบประมาณ</th><th>งบประมาณ</th><th>คงเหลือ</th><th>ผลการใช้งบ</th></tr></thead><tbody id="budgetRiskUnderRows"></tbody></table></div></article></section></section><section class="card annual-table budget-detail-only"><div class="table-head"><div class="table-title">รายการงบประมาณ <span id="budgetLabel">รอข้อมูลจากฐาน</span></div><div class="legend">จัดกลุ่มตามประเภทงบ · เรียงกลุ่มและรายการตามคงเหลือน้อยไปมาก</div></div><div class="table-wrap"><table><thead><tr><th>ลำดับ</th><th>ชื่องบประมาณ</th><th>ประเภทงบ</th><th style="text-align:right">งบประมาณ</th><th style="text-align:right">ใช้ Q1</th><th style="text-align:right">ใช้ Q2</th><th style="text-align:right">ใช้ Q3</th><th style="text-align:right">ใช้ Q4</th><th style="text-align:right">รวมใช้ไป</th><th style="text-align:right" title="ส่วนของ &quot;รวมใช้ไป&quot; ที่ PO ผูกกับปีงบอื่น (แต่รับในช่วงปีงบที่เลือก)">เหลื่อมปี</th><th style="text-align:right">คงเหลือ</th><th>แนวโน้มไตรมาส</th><th>ผลการใช้งบ</th><th>สถานะ</th></tr></thead><tbody id="budgetRows"><tr><td colspan="14" class="empty">กำลังอ่านข้อมูลงบประมาณ…</td></tr></tbody></table></div></section>';
    $('main').appendChild(view);
    const budgetFilter=view.querySelector('.annual-filter'),budgetSourceControls=document.createElement('div');budgetSourceControls.className='annual-source-controls';budgetSourceControls.innerHTML='<span class="annual-group-label">เงื่อนไขข้อมูล</span>';[...budgetFilter.children].forEach(element=>budgetSourceControls.appendChild(element));budgetFilter.appendChild(budgetSourceControls);
    const budgetSearchInput=$('budgetSearch'),budgetSearchGroup=document.createElement('label');budgetSearchGroup.className='annual-search-group';budgetSearchGroup.innerHTML='<span class="annual-group-label">ค้นหารายการ</span>';budgetSearchInput.replaceWith(budgetSearchGroup);budgetSearchGroup.appendChild(budgetSearchInput);
    const style=document.createElement('style');style.textContent=`#budgetView.mode-detail{overflow:hidden}#budgetView .annual-table table{min-width:1560px}#budgetView .annual-table td:nth-child(2){max-width:260px;overflow:hidden;text-overflow:ellipsis}#budgetView .budget-type-group td{padding:8px 12px;background:#eef4f1;font-weight:700;color:#176b54;border-top:2px solid #dce7e2}#budgetView .budget-type-group .sub{font-weight:400;color:var(--muted);margin-left:8px}#budgetView .quarter-card{cursor:default}#budgetView .quarter-card small{display:block}#budgetView .spark-bars{display:flex;align-items:flex-end;gap:2px;height:26px;width:44px}#budgetView .spark-bars i{flex:1;background:#278267;border-radius:1px 1px 0 0;min-height:2px;display:block}#budgetView .hospital-overview{grid-template-columns:.62fr 1.38fr}#budgetView .annual-risk-section{margin-top:0}#budgetView.mode-dashboard .budget-detail-only{display:none}#budgetView.mode-detail .budget-dashboard-only{display:none!important}#budgetView .annual-table{min-height:540px}#budgetView .annual-table .table-wrap{min-height:470px}#budgetView tr.budget-drill-row{cursor:pointer}#budgetView tr.budget-drill-row:hover td{filter:brightness(.97)}`;document.head.appendChild(style);
    $('budgetApply').addEventListener('click',loadBudgetTracking);
    $('budgetSearch').addEventListener('input',debounce(renderBudgetTracking));
    view.addEventListener('click',event=>{const row=event.target.closest('tr.budget-drill-row');if(!row)return;openBudgetDrill(row.dataset.budgetId,row.dataset.budgetName)});
    setBudgetViewMode('dashboard');
    mountBudgetDrill();
  }
  function mountBudgetDrill() {
    const box=document.createElement('div');box.id='budgetDrillBox';box.className='session-box budget-drill-box';
    box.innerHTML='<div class="session-dialog budget-drill-dialog"><div class="budget-drill-head"><div><h2 id="budgetDrillTitle">รายการซื้อภายใต้งบ</h2><p id="budgetDrillSub">—</p></div><button class="btn" id="budgetDrillClose" type="button" aria-label="ปิด">✕</button></div><div class="budget-drill-kpis"><div><span>จำนวน PO</span><b id="budgetDrillPoCount">—</b></div><div><span>รายการสินค้า</span><b id="budgetDrillItemCount">—</b></div><div><span>มูลค่ารวม (ตาม PO)</span><b id="budgetDrillAmount">—</b></div></div><div class="budget-drill-toolbar"><input id="budgetDrillSearch" class="session-input" placeholder="ค้นหาเลขที่ PO ในหน้านี้ (หรือรหัส/ชื่อรายการในใบที่เปิดดูแล้ว)"><div class="detail-pager"><label>แสดง <select id="budgetDrillPageSize"><option value="20">20</option><option value="50">50</option><option value="100">100</option></select> PO</label><button type="button" id="budgetDrillPrev">ก่อนหน้า</button><span id="budgetDrillPageInfo">หน้า 1 / 1</span><button type="button" id="budgetDrillNext">ถัดไป</button></div></div><div class="table-wrap budget-drill-table-wrap"><table><thead><tr><th>เลขที่ PO</th><th>วันที่</th><th>คลัง</th><th style="text-align:right">รายการสินค้า</th><th style="text-align:right">มูลค่า PO</th></tr></thead><tbody id="budgetDrillRows"><tr><td colspan="5" class="empty">เลือกงบประมาณจากตารางเพื่อดูรายการซื้อ</td></tr></tbody></table></div></div>';
    document.body.appendChild(box);
    const style=document.createElement('style');style.textContent=`.budget-drill-dialog{width:min(1100px,94vw);max-height:88vh;display:flex;flex-direction:column;gap:10px;padding:20px}.budget-drill-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}.budget-drill-head h2{margin:0;font-size:16px}.budget-drill-head p{margin:4px 0 0;font-size:.6875rem;color:var(--muted)}#budgetDrillClose{width:32px;height:32px;padding:0;border-radius:8px;flex:none}.budget-drill-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.budget-drill-kpis>div{padding:9px 12px;border:1px solid var(--line);border-radius:9px;background:#f7fbf9}.budget-drill-kpis span{display:block;font-size:.625rem;color:var(--muted)}.budget-drill-kpis b{display:block;margin-top:3px;font:700 1rem Inter;color:#176b54}.budget-drill-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}.budget-drill-toolbar .session-input{margin-bottom:0;flex:1 1 260px}.budget-drill-table-wrap{flex:1;min-height:0;overflow:auto;border:1px solid var(--line);border-radius:9px}.budget-drill-table-wrap>table{width:100%;min-width:600px;font-size:.75rem}.po-summary-row{cursor:pointer}.po-summary-row:hover td{filter:brightness(.97)}.po-toggle{display:inline-block;width:12px;color:#278267;font-weight:700}.po-items-row td{padding:0;background:#f7fbf9}.po-items-table{width:100%;font-size:.75rem}.po-items-table th{background:#eef4f1;font-size:.625rem}.po-items-table td,.po-items-table th{padding:6px 11px 6px 34px}`;document.head.appendChild(style);
    $('budgetDrillClose').addEventListener('click',closeBudgetDrill);
    box.addEventListener('click',event=>{if(event.target===box)closeBudgetDrill()});
    $('budgetDrillSearch').addEventListener('input',debounce(renderBudgetDrill));
    $('budgetDrillRows').addEventListener('click',event=>{const row=event.target.closest('tr.po-summary-row');if(!row)return;toggleBudgetDrillPo(row.dataset.poId)});
    $('budgetDrillPageSize').addEventListener('change',()=>{budgetDrillPageSize=Number($('budgetDrillPageSize').value);loadBudgetDrillPage(1)});
    $('budgetDrillPrev').addEventListener('click',()=>{if(budgetDrillPage>1)loadBudgetDrillPage(budgetDrillPage-1)});
    $('budgetDrillNext').addEventListener('click',()=>{loadBudgetDrillPage(budgetDrillPage+1)});
  }
  function setBudgetViewMode(mode) {
    budgetViewMode=mode;const view=$('budgetView');if(!view)return;view.classList.toggle('mode-dashboard',mode==='dashboard');view.classList.toggle('mode-detail',mode==='detail');view.style.overflow=mode==='detail'?'hidden':'auto';
  }
  function applyFilterContext(view) {
    const toolbar=document.querySelector('.toolbar'),label=toolbar.querySelector('.filter-label'),basis=toolbar.querySelector('.date-basis'),search=$('search');
    const previous=search.dataset.context;if(previous)contextualSearch[previous]=search.value;search.dataset.context=view;search.value=contextualSearch[view]||'';
    toolbar.dataset.context=view;
    toolbar.style.display=(view.startsWith('plan')||view.startsWith('budget'))?'none':'flex';
    if(view==='flow'){
      label.textContent='ช่วงวันที่คำขอ PR';basis.style.display='none';search.style.display='';search.placeholder='ค้นหาเลขที่ PR / PO / ใบส่งของ';$('apply').innerHTML='<span aria-hidden="true">⌕</span> ติดตาม';
    }else{
      label.textContent=view==='items'?'ช่วงวันที่จัดซื้อ':'ช่วงวันที่';basis.style.display='flex';search.style.display=view==='list'?'':'none';search.placeholder='ค้นหาเลขที่ PO / ผู้ขาย';$('apply').innerHTML='<span aria-hidden="true">⌕</span> ค้นหา';
    }
    $('export').style.display=view==='list'?'inline-flex':'none';
  }
  mountExecutiveDashboard();
  mountTypographyControls();
  mountDateBasisControls();
  mountFilterPolish();
  mountProcessFlow();
  mountAnnualPlan();
  mountBudgetTracking();
  const detailViewportFix=document.createElement('style');
  detailViewportFix.textContent=`.mode-detail#annualPlanView{overflow:hidden}.mode-detail:not(.show-unplanned) .annual-planned-detail{flex:1 1 auto;min-height:0;display:flex!important;flex-direction:column}.mode-detail.show-unplanned .annual-planned-detail{display:none!important}.mode-detail:not(.show-unplanned) .annual-unplanned{display:none!important}.mode-detail.show-unplanned .annual-unplanned{display:flex!important;flex:1 1 auto;min-height:0;flex-direction:column}.mode-detail.show-unplanned .annual-unplanned .unplanned-layout{flex:1 1 auto;min-height:0}.mode-detail.show-unplanned .annual-unplanned .table-wrap{display:block;flex:1 1 0;height:0!important;min-height:0!important;max-height:none!important;overflow-x:auto!important;overflow-y:scroll!important;overscroll-behavior:contain;scrollbar-gutter:stable}.mode-detail:not(.show-unplanned) .annual-table .table-wrap{flex:1 1 auto;height:auto!important;min-height:0!important;overflow:auto!important}.mode-detail .annual-unplanned .table-wrap table,.mode-detail .annual-table .table-wrap table{margin-bottom:18px}@media(max-width:1050px){.mode-detail#annualPlanView{overflow:auto}.mode-detail:not(.show-unplanned) .annual-planned-detail,.mode-detail.show-unplanned .annual-unplanned{flex:none}.mode-detail.show-unplanned .annual-unplanned .table-wrap,.mode-detail:not(.show-unplanned) .annual-table .table-wrap{height:calc(100vh - 360px)!important;min-height:320px!important}}`;
  document.head.appendChild(detailViewportFix);
  const contextStyle=document.createElement('style');contextStyle.textContent=`.filter-toolbar #apply{display:none!important}.filter-toolbar[data-context="flow"] .warehouse-filter,.filter-toolbar[data-context="flow"] .budget-filter,.filter-toolbar[data-context="flow"] .status-filter{display:none!important}.filter-toolbar[data-context="flow"] #export,.filter-toolbar[data-context="flow"] #resetFilters{display:none!important}.menu .plan-group-label{display:block;margin:13px 12px 4px;color:#7fa697;font-size:.625rem}.menu .nav.subnav{margin-left:12px;width:calc(100% - 12px);padding-left:18px;font-size:.75rem}.menu .nav.subnav i{font-size:.75rem}.unplanned-badge{border:0;cursor:pointer}#resetFilters{width:38px!important;min-width:38px!important;padding:0!important;font-size:1rem!important}.filter-toolbar{flex-wrap:nowrap!important;gap:6px!important;padding:7px 9px!important}.filter-toolbar .field{flex:0 1 135px!important}.filter-toolbar .date-filter{display:flex!important;align-items:flex-end!important;flex:1 1 560px!important;gap:6px}.filter-toolbar .date-filter-head{flex:0 0 auto;margin:0!important}.filter-toolbar .date-filter-head>.filter-label{display:none}.filter-toolbar .date-filter-tools{flex-wrap:nowrap!important;gap:5px!important}.filter-toolbar .date-quick button{padding:4px 8px}.filter-toolbar .date-basis span{padding:4px 8px}.filter-toolbar .date-range-row{flex:1 1 315px;grid-template-columns:minmax(115px,1fr) 14px minmax(115px,1fr) 32px!important;gap:4px!important}.filter-toolbar .buddhist-date-box{gap:0}.filter-toolbar .buddhist-date-box small{display:none}.filter-toolbar .buddhist-date-display,.filter-toolbar select,.filter-toolbar .btn{height:32px!important}.filter-toolbar #clearDate{width:32px!important;height:32px!important}.filter-toolbar .field>label{margin-bottom:3px!important;font-size:.625rem!important}.filter-toolbar .btn{min-width:65px!important;padding:0 10px!important}@media(max-width:1250px){.filter-toolbar{flex-wrap:wrap!important}.filter-toolbar .date-filter{flex-basis:100%!important}.filter-toolbar .field{flex:1 1 140px!important}}@media(max-width:720px){.filter-toolbar .date-filter{display:grid!important}.filter-toolbar .date-filter-tools{flex-wrap:wrap!important}.filter-toolbar .date-range-row{grid-template-columns:1fr!important}.filter-toolbar .buddhist-date-box small{display:block}}`;document.head.appendChild(contextStyle);
  applyFilterContext('dashboard');
  const tableHeader=$('listView').querySelector('thead tr'), sequenceHeader=document.createElement('th'); sequenceHeader.textContent='ลำดับ'; sequenceHeader.style.textAlign='center'; tableHeader.prepend(sequenceHeader);
  const creditorHeader=[...tableHeader.children].find(th=>th.textContent.includes('เลขตั้งหนี้'))||tableHeader.children[6];
  ['วิธีจัดซื้อ','วิธีการชำระเงิน','วันที่ส่งการเงิน'].forEach(label=>{const th=document.createElement('th');th.textContent=label;tableHeader.insertBefore(th,creditorHeader)});
  creditorHeader.remove();
  const initialEmpty=$('rows').querySelector('[colspan]'); if(initialEmpty) initialEmpty.colSpan=11;
  const pager=document.createElement('div'); pager.style.cssText='display:flex;align-items:center;gap:6px;margin-left:auto'; pager.innerHTML='<label for="pageSize" style="font-size:.75rem;color:#6f7b76">แสดง</label><select id="pageSize" style="height:30px;border:1px solid #e3e9e6;border-radius:7px;background:#fff;padding:0 7px"><option value="50">50</option><option value="100">100</option><option value="500">500</option></select><span id="pageInfo" style="min-width:72px;text-align:center;font-size:.75rem;color:#6f7b76">หน้า 1 / 1</span><button class="btn" id="prevPage" type="button">ก่อนหน้า</button><button class="btn" id="nextPage" type="button">ถัดไป</button>';
  $('listView').querySelector('.table-head').appendChild(pager);
  $('pageSize').addEventListener('change',()=>{pageSize=Number($('pageSize').value);currentPage=1;renderRows()}); $('prevPage').addEventListener('click',()=>{if(currentPage>1){currentPage--;renderRows()}}); $('nextPage').addEventListener('click',()=>{currentPage++;renderRows()});
  $('itemSearch').addEventListener('input',debounce(()=>{itemPage=1;renderItemMonitor()}));
  $('itemPageSize').addEventListener('change',()=>{itemPageSize=Number($('itemPageSize').value);itemPage=1;renderItemMonitor()});
  $('itemPrev').addEventListener('click',()=>{if(itemPage>1){itemPage--;renderItemMonitor()}}); $('itemNext').addEventListener('click',()=>{itemPage++;renderItemMonitor()}); $('itemExport').addEventListener('click',exportItemRegistry);
  $('itemRegistryRows').addEventListener('click',event=>{const row=event.target.closest('.item-detail-row');if(row)showItemDetail(row.dataset.itemKey)});
  $('itemDetailModal').addEventListener('click',event=>{if(event.target===$('itemDetailModal')||event.target.closest('.item-modal-close'))$('itemDetailModal').classList.remove('show')});
  document.querySelectorAll('.nav').forEach(button=>button.addEventListener('click',()=>{
    document.querySelectorAll('.nav').forEach(x=>x.classList.remove('active')); button.classList.add('active');
    const view=button.dataset.view, dashboard=view==='dashboard', list=view==='list', items=view==='items', flow=view==='flow', planDashboard=view==='plan',planDetail=view==='plan-detail',plan=planDashboard||planDetail,budgetDashboard=view==='budget',budgetDetail=view==='budget-detail',budget=budgetDashboard||budgetDetail;
    $('dashboardView').style.display=dashboard?'flex':'none'; $('listView').style.display=list?'flex':'none'; $('itemMonitorView').style.display=items?'flex':'none'; $('flowView').style.display=flow?'flex':'none'; $('annualPlanView').style.display=plan?'flex':'none'; $('budgetView').style.display=budget?'flex':'none';
    $('pageTitle').textContent=dashboard?'ภาพรวมงานจัดซื้อ':list?'รายการใบสั่งซื้อ':items?'ทะเบียนและติดตามข้อมูลรายการจัดซื้อ':flow?'ติดตามกระบวนการจัดซื้อครบวงจร':planDetail?'รายละเอียดแผนจัดซื้อ':budgetDetail?'รายการงบประมาณ':budgetDashboard?'ติดตามการใช้งบประมาณ':'Dashboard แผนจัดซื้อ';
    applyFilterContext(view);
    if(list)renderRows();if(items)renderItemMonitor();if(flow)renderProcessFlow();if(plan){setAnnualViewMode(planDetail?'detail':'dashboard');renderAnnualPlan();const key=`${$('annualYear').value}|${$('annualWarehouse').value}`;if(config&&annualLoadedKey!==key)loadAnnualPlanSelection()}if(budget){setBudgetViewMode(budgetDetail?'detail':'dashboard');renderBudgetTracking();if(config&&budgetLoadedYear!==$('budgetYear').value)loadBudgetTracking()}
  }));
  const initial = cleanSessionFromUrl(); if (initial) loadDatabase(initial); else { $('sessionBox').classList.add('show'); $('updatedAt').textContent='รอ BMS Session เพื่ออ่านข้อมูลจากฐาน HOSxP'; }
})();
</script></body></html>
