<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>BMS Purchase Flow</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Inter:wght@600;700&display=swap');
:root{--nav:#112a23;--green:#176b54;--ink:#18231f;--muted:#6f7b76;--line:#e3e9e6;--bg:#f3f6f4;--red:#d54e4e;--amber:#dc912f}*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font-family:'IBM Plex Sans Thai',sans-serif}button,input,select{font:inherit}.app{min-height:100vh;display:grid;grid-template-columns:238px minmax(0,1fr)}aside{height:100vh;position:sticky;top:0;background:var(--nav);color:#aac0b7;padding:22px 16px;display:flex;flex-direction:column}.brand{display:flex;gap:10px;align-items:center;padding:0 8px 24px}.logo{width:39px;height:39px;border-radius:11px;background:linear-gradient(145deg,#39ad83,#1e755a);display:grid;place-items:center;color:#fff;font:700 14px Inter;box-shadow:0 8px 18px #07191455}.brand strong{display:block;color:#fff;font-size:15px}.brand small{font-size:10px;color:#78988b}.nav-label{padding:0 10px 8px;font-size:9px;font-weight:700;letter-spacing:.14em;color:#718f84}nav{display:grid;gap:5px}.nav{border:0;background:transparent;color:#aac0b7;border-radius:9px;padding:10px 11px;display:flex;gap:11px;align-items:center;text-align:left;cursor:pointer}.nav:hover,.nav.active{background:#ffffff12;color:#fff}.nav.active{box-shadow:inset 3px 0 #4cc096}.ico{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}.count{margin-left:auto;background:#ecb359;color:#3d2b14;border-radius:7px;padding:2px 6px;font:700 9px Inter}.side-foot{margin-top:auto;padding:14px 9px;border-top:1px solid #ffffff12;font-size:10px}.dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#55d39e;box-shadow:0 0 0 4px #55d39e18;margin-right:7px}main{height:100vh;min-width:0;overflow:hidden;padding:19px 23px 17px;display:flex;flex-direction:column;gap:12px}header{display:flex;justify-content:space-between;align-items:center}h1{margin:0;font-size:22px;letter-spacing:-.02em}.sub{color:var(--muted);font-size:10px}.actions{display:flex;align-items:center;gap:9px}.search{height:36px;width:210px;border:1px solid var(--line);border-radius:9px;background:#fff;padding:0 12px;outline:none}.avatar{width:36px;height:36px;border-radius:10px;background:#dcece5;color:var(--green);font-weight:700;display:grid;place-items:center}.toolbar,.card{background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 5px 17px #173c3010}.toolbar{padding:9px 11px;display:flex;gap:8px;align-items:end}.field{min-width:125px}.field.wide{min-width:185px}.field label{display:block;font-size:9px;color:var(--muted);margin:0 0 3px 3px}.field select,.date{width:100%;height:31px;border:0;border-radius:7px;background:#f3f6f4;padding:0 9px;color:#394640;font-size:10px}.date{display:flex;align-items:center}.spacer{flex:1}.btn{height:32px;border:1px solid var(--line);border-radius:7px;background:#fff;padding:0 12px;color:#41504a;font-size:10px;font-weight:600;cursor:pointer}.btn.primary{background:var(--green);border-color:var(--green);color:#fff}.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:9px}.kpi{padding:11px 13px;position:relative;overflow:hidden}.kpi:before{content:"";position:absolute;left:0;top:12px;width:3px;height:30px;background:var(--c,#208369);border-radius:0 3px 3px 0}.k-label{font-size:10px;color:var(--muted)}.k-value{font:700 22px Inter;margin-top:3px;letter-spacing:-.04em}.unit{font:400 9px 'IBM Plex Sans Thai';color:var(--muted);margin-left:4px}.trend{font-size:9px;color:var(--muted);margin-top:4px}.trend b{color:var(--c,#208369)}.insights{display:grid;grid-template-columns:1.5fr .6fr;gap:9px}.panel{padding:11px 13px}.panel-head{display:flex;justify-content:space-between;margin-bottom:8px}.title{font-size:11px;font-weight:700}.note{font-size:8px;color:var(--muted)}.bars{height:61px;display:grid;grid-template-columns:repeat(4,1fr);gap:10px;align-items:end}.bar-col{height:100%;display:grid;grid-template-rows:1fr auto;gap:3px}.track{background:#edf1ef;border-radius:5px;display:flex;align-items:end;overflow:hidden}.bar{width:100%;height:var(--h);background:var(--c);border-radius:5px 5px 0 0}.meta{display:flex;justify-content:space-between;font-size:8px;color:var(--muted)}.meta b{font:600 8px Inter;color:#35423e}.funnel{display:grid;gap:6px}.frow{display:grid;grid-template-columns:75px 1fr 20px;gap:7px;align-items:center;font-size:8px;color:var(--muted)}.ftrack{height:6px;background:#edf1ef;border-radius:5px;overflow:hidden}.fill{height:100%;width:var(--w);background:var(--c);border-radius:5px}.frow b{text-align:right;font:600 9px Inter;color:#35423e}.table-card{flex:1;min-height:0;overflow:hidden;display:flex;flex-direction:column}.table-head{padding:10px 13px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between}.table-title{font-size:12px;font-weight:700}.table-title span,.legend{font-size:8px;color:var(--muted);font-weight:400}.legend b{color:var(--red)}.table-wrap{overflow:auto;flex:1;scrollbar-width:auto;scrollbar-color:#a9beb4 #eef2f0}.table-wrap::-webkit-scrollbar{height:14px;width:12px}.table-wrap::-webkit-scrollbar-track{background:#eef2f0}.table-wrap::-webkit-scrollbar-thumb{background:#a9beb4;border-radius:7px;border:3px solid #eef2f0}.table-wrap::-webkit-scrollbar-thumb:hover{background:#7e9489}table{width:100%;border-collapse:collapse;white-space:nowrap;font-size:9.5px}th{position:sticky;top:0;background:#f7f9f8;color:#7c8782;text-align:left;padding:7px 11px;font-size:8px;border-bottom:1px solid var(--line)}td{padding:7px 11px;border-bottom:1px solid #edf0ee;color:#38453f}tbody tr:hover{background:#f8fbf9}.po{font:600 9px Inter;color:var(--green)}td .sub{display:block;font-size:8px}.money{text-align:right;font:600 9px Inter}.age{text-align:center}.age strong{color:var(--red);font:700 10px Inter}.badge{padding:3px 6px;border-radius:6px;font-size:8px;font-weight:600;display:inline-flex;align-items:center;gap:4px}.badge:before{content:"";width:4px;height:4px;border-radius:50%;background:currentColor}.danger{color:#c74343;background:#fdeceb}.warn{color:#ae6b17;background:#fff2dd}.info{color:#3973a8;background:#eaf1f9}.ok{color:#26765a;background:#e9f6ef}
@media(max-width:1050px){.app{grid-template-columns:74px minmax(0,1fr)}aside{padding:20px 10px}.brand{justify-content:center;padding-inline:0}.brand div:last-child,.nav-label,.nav span,.side-foot span{display:none}.nav{justify-content:center}.count{position:absolute;margin:0 0 22px 25px}.k-value{font-size:18px}}@media(max-width:720px){.app{display:block}aside{height:auto;position:sticky;z-index:5;display:flex;flex-direction:row;padding:7px 10px;align-items:center}.brand{padding:0;margin-right:auto}.logo{width:34px;height:34px}nav{display:flex}.nav{width:38px}.nav:nth-child(n+4),.side-foot{display:none}main{height:auto;min-height:100vh;overflow:visible;padding:14px}.search{display:none}.kpis{grid-template-columns:repeat(2,1fr)}.kpi:last-child{grid-column:span 2}.insights{grid-template-columns:1fr}.table-card{min-height:360px}}
.empty{text-align:center!important;padding:35px!important;color:var(--muted)}.session-box{position:fixed;inset:0;background:#10251fbb;z-index:20;display:none;place-items:center;padding:20px}.session-box.show{display:grid}.session-dialog{width:min(430px,100%);background:#fff;border-radius:16px;padding:22px;box-shadow:0 25px 70px #07191466}.session-dialog h2{margin:0 0 5px;font-size:18px}.session-dialog p{font-size:11px;color:var(--muted);margin:0 0 15px}.session-input{width:100%;height:40px;border:1px solid var(--line);border-radius:9px;padding:0 11px;outline:none;margin-bottom:9px}.session-error{min-height:17px;color:var(--red);font-size:10px}.loading{opacity:.6;pointer-events:none}
</style></head><body><div class="session-box" id="sessionBox"><div class="session-dialog"><h2>เชื่อมต่อ BMS Session</h2><p>ไม่พบ Session จาก URL หรือ Cookie กรุณาวาง BMS Session ID เพื่ออ่านข้อมูลจาก HOSxP</p><input class="session-input" id="sessionInput" autocomplete="off" placeholder="BMS Session ID"><div class="session-error" id="sessionError"></div><button class="btn primary" id="connect">เชื่อมต่อฐานข้อมูล</button></div></div><div class="app"><aside><div class="brand"><div class="logo">BMS</div><div><strong>Purchase Flow</strong><small>Hospital Supply</small></div></div><div class="nav-label">เมนูหลัก</div><nav>
<button class="nav active" data-view="dashboard"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg><span>ภาพรวมงานจัดซื้อ</span></button>
<button class="nav" data-view="list"><svg class="ico" viewBox="0 0 24 24"><path d="M6 2h9l4 4v16H6zM14 2v5h5M9 12h7M9 16h7"/></svg><span>รายการใบสั่งซื้อ</span></button>
<button class="nav" data-view="items"><svg class="ico" viewBox="0 0 24 24"><path d="M4 7l8-4 8 4-8 4zM4 7v10l8 4 8-4V7M12 11v10"/></svg><span>ติดตามข้อมูลการจัดซื้อ</span></button>
<button class="nav" data-view="flow"><svg class="ico" viewBox="0 0 24 24"><path d="M4 6h4v4H4zM10 8h4M16 6h4v4h-4zM18 10v4M16 16h4v4h-4zM14 18h-4M4 16h4v4H4zM6 16v-4"/></svg><span>ติดตามกระบวนการ</span></button>
<span class="plan-group-label">แผนจัดซื้อประจำปี</span>
<button class="nav subnav" data-view="plan"><svg class="ico" viewBox="0 0 24 24"><path d="M5 3h14v18H5zM8 7h8M8 11h3M8 15h3M14 11v5M12 14h4"/></svg><span>Dashboard แผนจัดซื้อ</span></button>
<button class="nav subnav" data-view="plan-detail"><svg class="ico" viewBox="0 0 24 24"><path d="M5 3h14v18H5zM8 7h8M8 11h8M8 15h8"/></svg><span>รายละเอียดแผน</span></button>
<span class="plan-group-label">งบประมาณ</span>
<button class="nav subnav" data-view="budget"><svg class="ico" viewBox="0 0 24 24"><path d="M3 6h18M3 6v12a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6M3 6l2-3h14l2 3M9 12h6"/></svg><span>ติดตามการใช้งบประมาณ</span></button>
<button class="nav subnav" data-view="budget-detail"><svg class="ico" viewBox="0 0 24 24"><path d="M5 3h14v18H5zM8 7h8M8 11h8M8 15h8"/></svg><span>รายการงบประมาณ</span></button>
</nav><div class="side-foot"><div><i class="dot" id="sessionDot"></i><span id="sessionState">กำลังเชื่อมต่อ BMS Session</span></div><div style="margin-top:6px;color:#6f9184;font:9px Inter">Build 2026.08.29-P46</div></div></aside><main id="main">
<header><div><h1 id="pageTitle">ภาพรวมงานจัดซื้อ</h1><div class="sub" id="updatedAt">กำลังอ่านข้อมูลจากฐาน HOSxP…</div></div><div class="actions"><input class="search" id="search" placeholder="ค้นหาเลขที่ PO / ผู้ขาย"><div class="avatar" id="avatar">BMS</div></div></header>
<section class="toolbar"><div class="field wide" style="min-width:310px"><label>ช่วงวันที่ออก PO</label><div style="display:grid;grid-template-columns:1fr auto 1fr auto;align-items:center;gap:6px"><input type="date" id="dateFrom" aria-label="วันที่เริ่มต้น" style="height:31px;min-width:120px;border:0;border-radius:7px;background:#f3f6f4;padding:0 8px;color:#394640;font-size:10px"><span style="color:#9aa49f;font-size:10px">ถึง</span><input type="date" id="dateTo" aria-label="วันที่สิ้นสุด" style="height:31px;min-width:120px;border:0;border-radius:7px;background:#f3f6f4;padding:0 8px;color:#394640;font-size:10px"><button id="clearDate" title="ล้างช่วงวันที่" style="width:27px;height:27px;border:0;border-radius:7px;background:#edf2ef;color:#718079;cursor:pointer">×</button></div></div><div class="field"><label>คลัง</label><select id="department"><option value="all">ทั้งหมด</option></select></div><div class="field"><label>งบประมาณ</label><select id="budget"><option value="all">ทั้งหมด</option></select></div><div class="field"><label>สถานะจ่าย</label><select id="status"><option value="all">ทุกสถานะ</option><option value="pending">รอส่งการเงิน</option><option value="finance">อยู่ระหว่างการเงิน</option><option value="paid">ชำระแล้ว</option></select></div><div class="spacer"></div><button class="btn primary" id="apply">ค้นหา</button><button class="btn" id="export">⇩ Excel</button></section>
<div id="dashboardView" style="display:flex;flex-direction:column;gap:9px;min-height:0;flex:1"><section class="kpis"><article class="card kpi"><div class="k-label">ใบสั่งซื้อทั้งหมด</div><div class="k-value" id="kTotal">—</div><div class="trend">ข้อมูลจริงจาก stock_po</div></article><article class="card kpi" style="--c:#d54e4e"><div class="k-label">ยังไม่ส่งการเงิน</div><div class="k-value" id="kPending">—</div><div class="trend" id="kPendingSub">รอข้อมูล</div></article><article class="card kpi" style="--c:#dc912f"><div class="k-label">เกินกำหนด 30 วัน</div><div class="k-value" id="kOverdue">—</div><div class="trend"><b>ต้องเร่งติดตาม</b></div></article><article class="card kpi" style="--c:#3978ad"><div class="k-label">อยู่ระหว่างการเงิน</div><div class="k-value" id="kFinance">—</div><div class="trend" id="kFinanceSub">รอข้อมูล</div></article><article class="card kpi" style="--c:#21846a"><div class="k-label">ชำระแล้ว</div><div class="k-value" id="kPaid">—</div><div class="trend" id="kPaidSub">รอข้อมูล</div></article></section><section class="insights"><article class="card panel"><div class="panel-head"><div class="title">อายุใบสั่งซื้อที่ยังไม่ส่งการเงิน</div><div class="note">ตัวชี้วัดความล่าช้า</div></div><div class="bars" id="ageBars"><div class="empty">รอข้อมูลจากฐาน</div></div></article><article class="card panel"><div class="panel-head"><div class="title">สถานะกระบวนการจัดซื้อ</div><div class="note" id="funnelTotal">— รายการ</div></div><div class="funnel" id="funnel"><div class="empty">รอข้อมูลจากฐาน</div></div></article></section><section class="chart-pair"><article class="card panel"><div class="panel-head"><div class="title">มูลค่า PO ตามคลัง</div><div class="note">5 อันดับสูงสุด</div></div><div class="funnel" id="warehouseChart"><div class="empty">รอข้อมูลจากฐาน</div></div></article><article class="card panel"><div class="panel-head"><div class="title">มูลค่า PO ตามงบประมาณ</div><div class="note">5 อันดับสูงสุด</div></div><div class="funnel" id="budgetChart"><div class="empty">รอข้อมูลจากฐาน</div></div></article></section></div>
<section class="card table-card" id="listView" style="display:none"><div class="table-head"><div class="table-title">รายการใบสั่งซื้อ <span id="rowLabel">กำลังโหลดข้อมูล…</span></div><div class="legend">เรียงตามอายุเอกสาร • <b>● เกิน 30 วัน</b></div></div><div class="table-wrap"><table><thead><tr><th>เลขที่ PO / วันที่</th><th>ผู้ขาย</th><th>งบประมาณ / หน่วยงาน</th><th style="text-align:right">มูลค่า (บาท)</th><th>สถานะปัจจุบัน</th><th>เลขตั้งหนี้</th><th>อายุ</th><th>ผู้รับผิดชอบ</th></tr></thead><tbody id="rows"><tr><td colspan="8" class="empty">กำลังอ่านข้อมูลจากฐาน HOSxP…</td></tr></tbody></table></div></section>
<section id="itemMonitorView" style="display:none;min-height:0;flex:1;overflow:auto"><div class="item-monitor-kpis"><article class="card item-kpi"><span>รายการสินค้าในทะเบียน</span><b id="imItems">—</b><small>รายการไม่ซ้ำ</small></article><article class="card item-kpi"><span>จำนวนครั้งที่สั่งซื้อ</span><b id="imOrders">—</b><small>ใบสั่งซื้อไม่ซ้ำ</small></article><article class="card item-kpi"><span>จำนวนสั่งซื้อรวม</span><b id="imQuantity">—</b><small>ทุกหน่วยนับ</small></article><article class="card item-kpi"><span>มูลค่ารวมโดยประมาณ</span><b id="imAmount">—</b><small>จำนวน × ราคาต่อหน่วย</small></article></div><div class="item-monitor-grid"><article class="card panel"><div class="panel-head"><div class="title">รายการที่สั่งซื้อมากที่สุด</div><div class="note">10 อันดับตามจำนวนรวม</div></div><div id="itemTopQty" class="rank-chart"><div class="empty">รอข้อมูลจากฐาน</div></div></article><article class="card panel"><div class="panel-head"><div class="title">รายการที่มีมูลค่าสูงสุด</div><div class="note">10 อันดับตามมูลค่ารวม</div></div><div id="itemTopValue" class="rank-chart"><div class="empty">รอข้อมูลจากฐาน</div></div></article></div><section class="card item-registry"><div class="table-head"><div class="table-title">ทะเบียนรายการจัดซื้อ <span id="itemRegistryLabel">—</span></div><div class="registry-actions"><input id="itemSearch" class="registry-search" placeholder="ค้นหารหัส / ชื่อรายการ / บริษัทล่าสุด"><button class="btn" id="itemExport">⇩ Excel</button><select id="itemPageSize"><option value="50">50</option><option value="100">100</option><option value="500">500</option></select><button class="btn" id="itemPrev">ก่อนหน้า</button><span id="itemPageInfo">หน้า 1 / 1</span><button class="btn" id="itemNext">ถัดไป</button></div></div><div class="table-wrap"><table><thead><tr><th>รหัสรายการ</th><th>ชื่อรายการ</th><th>หน่วย</th><th>จำนวน PO</th><th style="text-align:right">ราคาเฉลี่ย</th><th style="text-align:right">ราคาซื้อล่าสุด</th><th>เทียบราคาเฉลี่ย</th><th>บริษัทที่ซื้อล่าสุด</th><th>วันที่ซื้อล่าสุด</th></tr></thead><tbody id="itemRegistryRows"><tr><td colspan="9" class="empty">กำลังอ่านข้อมูลรายการจัดซื้อ…</td></tr></tbody></table></div></section></section></main></div><script>
(() => {
  'use strict';
  const APP = 'BMS.Purchase.Flow';
  const SESSION_COOKIE = 'bms_session_id';
  const $ = id => document.getElementById(id);
  const esc = value => String(value ?? '').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
  const pick = (row, names, fallback = '') => {
    for (const name of names) if (row?.[name] !== undefined && row[name] !== null && row[name] !== '') return row[name];
    return fallback;
  };
  const num = value => Number(String(value ?? 0).replace(/,/g, '')) || 0;
  const money = value => num(value).toLocaleString('th-TH', {minimumFractionDigits:2, maximumFractionDigits:2});
  const dateText = value => {
    if (!value) return '—';
    const d = new Date(value);
    return Number.isNaN(d.getTime()) ? String(value) : d.toLocaleDateString('th-TH');
  };
  const ageDays = value => {
    const d = new Date(value);
    return Number.isNaN(d.getTime()) ? 0 : Math.max(0, Math.floor((Date.now() - d.getTime()) / 86400000));
  };
  const daysBetween = (from, to) => {
    const a=new Date(from), b=new Date(to);
    return Number.isNaN(a.getTime())||Number.isNaN(b.getTime()) ? null : Math.max(0,Math.floor((b-a)/86400000));
  };
  const officerDisplay = (name, id) => {
    const value=String(name||'').trim();
    if(!value || value===String(id??'') || /[A-Z]{3,}\s*$/.test(value) || /[*]{2,}/.test(value)) return id ? `รหัสผู้ใช้ ${id}` : '—';
    return value;
  };
  const cookie = name => document.cookie.split('; ').find(v => v.startsWith(name + '='))?.split('=').slice(1).join('=') || '';
  const saveSession = value => { document.cookie = `${SESSION_COOKIE}=${encodeURIComponent(value.trim())};max-age=10800;path=/;SameSite=Lax`; };
  const clearSession = () => { document.cookie = `${SESSION_COOKIE}=;max-age=0;path=/;SameSite=Lax`; };
  const cleanSessionFromUrl = () => {
    const url = new URL(location.href);
    const value = url.searchParams.get('bms-session-id');
    if (value) { saveSession(value); url.searchParams.delete('bms-session-id'); history.replaceState({}, '', url); }
    return value || decodeURIComponent(cookie(SESSION_COOKIE));
  };
  let records = [];
